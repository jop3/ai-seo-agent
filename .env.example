# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=ai-seo-agent-rg
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure AI Foundry / OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Cosmos DB
COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=seo-agent

# Azure Blob Storage
STORAGE_CONNECTION_STRING=your-storage-connection-string
STORAGE_CONTAINER=seo-data

# Google Search Console
GSC_CREDENTIALS_PATH=./credentials/gsc-service-account.json
GSC_PROPERTY_URL=https://www.example.com/

# Google Analytics 4
GA4_PROPERTY_ID=your-ga4-property-id
GA4_CREDENTIALS_PATH=./credentials/ga4-service-account.json

# SERP API (abstracted - supports multiple providers)
SERP_PROVIDER=serpapi  # serpapi, dataforseo, brightdata, or scraper
SERP_API_KEY=your-serp-api-key

# Optimizely
OPTIMIZELY_API_KEY=your-optimizely-api-key
OPTIMIZELY_PROJECT_ID=your-project-id

# Microsoft Teams Webhook (for alerts)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-change-in-production
LOG_LEVEL=INFO

# MVP Auth (simple API key for now)
API_KEY=your-api-key-for-mvp

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0
